      "type": "string",
      "minLength": 1
    },
    "source_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "equivalence_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
