            "file",
            "bytes",
            "sha256"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "equivalence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "bytes",
            "sha256"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
