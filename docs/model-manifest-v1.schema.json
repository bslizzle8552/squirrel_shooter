{
  "title": "Squirrel collector NCNN manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classes",
    "class_count",
    "input",
    "output",
    "runtime",
    "export_status",
    "equivalence_status",
